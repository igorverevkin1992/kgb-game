{
  "name": "liniya-kr",
  "private": true,
  "version": "0.0.1",
  "description": "«Линия КР: Вашингтон, 1985» — диегетический UI-симулятор резидента",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --trace off",
    "check": "npm run lint && npm run typecheck && npm run validate && npm run test && npm run build",
    "validate": "tsx tools/validate.ts"
  },
  "dependencies": {
    "@fontsource/pt-mono": "^5.3.0",
    "@fontsource/pt-sans-narrow": "^5.3.0",
    "@fontsource/pt-serif": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.7",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
